{
  "name": "MAKEatTADL",
  "env": {
    "RAILS_SERVE_STATIC_FILES": { "value": "enabled" },
    "RAILS_LOG_TO_STDOUT": { "value": "true" },
    "RAILS_ENV": { "value": "production" },
    "SECRET_KEY_BASE": { "generator": "secret" }
  },
  "dokku": {
    "plugins": [
      {
        "name": "postgres",
        "commands": [ "postgres:create $APP", "postgres:link   $APP $APP" ]
      }
    ]
  },
  "healthchecks": {
    "web": [
      {
        "type": "startup",
        "name": "web-ready-check",
        "path": "/up",
        "initialDelay": 5,
        "timeout": 5,
        "attempts": 3
      }
    ]
  },
  "scripts": {
    "dokku": {
      "predeploy": "bundle exec rails db:migrate",
      "postdeploy": "bundle exec rails db:seed"
    }
  },
  "buildpacks": [
    { "url": "heroku/nodejs" },
    { "url": "heroku/ruby" }
  ]
}
