<div class="container-fluid py-3">
  <div class="card mb-4">
    <div class="card-header bg-warning-subtle">
      <h3 class="mb-0">Merge Patron Record</h3>
    </div>
    <div class="card-body">
      <p class="mb-3">
        You are about to remove Patron <strong>#<%= @patron.id %></strong> and move its jobs and patron-authored messages onto another patron record.
      </p>

      <dl class="row mb-4">
        <dt class="col-sm-3">Losing Patron</dt>
        <dd class="col-sm-9">
          <strong><%= @patron.name.presence || "(no name)" %></strong><br>
          <span><%= @patron.email %></span><br>
          <small class="text-muted"><%= pluralize(@patron.jobs.count, "job") %> currently attached</small>
        </dd>
      </dl>

      <% if @merge_candidates.any? %>
        <%= form_with url: rails_admin.url_for(action: :merge_patron, model_name: "patron", id: @patron.id),
                      method: :post,
                      local: true,
                      data: { turbo: false } do %>
          <div class="mb-3">
            <label for="target_patron_id" class="form-label fw-bold">Winning Patron</label>
            <select name="target_patron_id" id="target_patron_id" class="form-select" required>
              <option value="">Select the patron record to keep</option>
              <% @merge_candidates.each do |candidate| %>
                <% label = "#{candidate.email}#{candidate.name.present? ? " (#{candidate.name})" : ""} - #{pluralize(candidate.try(:jobs_count).to_i, "job")}" %>
                <option value="<%= candidate.id %>" <%= "selected" if params[:target_patron_id].to_s == candidate.id.to_s %>>
                  <%= label %>
                </option>
              <% end %>
            </select>
            <div class="form-text">
              The winning patron keeps their email address. If their name is blank, the losing patron's name will be copied over.
            </div>
          </div>

          <div class="alert alert-warning mb-4">
            This cannot be undone from the admin UI. Jobs and patron-authored messages will be reassigned, then the losing patron record will be deleted.
          </div>

          <div class="d-flex gap-2">
            <%= submit_tag "Merge Patron", class: "btn btn-danger" %>
            <%= link_to "Cancel", rails_admin.show_path(model_name: "patron", id: @patron.id), class: "btn btn-outline-secondary" %>
          </div>
        <% end %>
      <% else %>
        <div class="alert alert-info mb-0">
          There are no other patron records available to merge into.
        </div>
      <% end %>
    </div>
  </div>
</div>
