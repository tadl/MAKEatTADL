<%
  # Date presets for quick links
  today        = Date.current
  yesterday    = (today - 1.day)..(today - 1.day)
  last_7_days  = (today - 6.days)..today
  last_30_days = (today - 29.days)..today
  curr_month   = today.beginning_of_month..today
  prev_month   = (today - 1.month).beginning_of_month..(today - 1.month).end_of_month
  curr_year    = today.beginning_of_year..today
  prev_year    = today.last_year.beginning_of_year..today.last_year.end_of_year

  # Selected range (default: last 30 days)
  start_date = params[:start].present? ? Date.parse(params[:start]) : last_30_days.begin
  end_date   = params[:end].present?   ? Date.parse(params[:end])   : last_30_days.end
  locations  = PickupLocation.order(Arel.sql('LOWER(name) ASC'))
  selected_location = locations.find_by(code: params[:location].presence)
  location_code = selected_location&.code
  location_params = location_code ? { location: location_code } : {}

  report = PrintJobReport.new(
    start_date: start_date,
    end_date: end_date,
    pickup_location: location_code
  )

  # Chart data (completions)
  prints_per_day        = report.prints_per_day          # { Date => qty }
  filament_per_day      = report.filament_per_day        # { Date => grams }
  filament_color_counts = report.filament_color_counts   # { "black" => total prints, ... }

  # --- Ensure every day in range has a point (fill gaps with 0) ---
  all_days        = (start_date.to_date..end_date.to_date).to_a
  day_labels      = all_days.map { |d| d.strftime("%b %-d") }
  prints_series   = all_days.map { |d| prints_per_day[d]   || 0 }
  filament_series = all_days.map { |d| filament_per_day[d] || 0 }

  # Use codes as canonical keys, titleize for labels
  filament_color_codes  = filament_color_counts.keys
  filament_color_labels = filament_color_codes.map(&:titleize)
  filament_color_values = filament_color_counts.values

  # Pull hexes from FilamentColor.rgb, fallback palette if missing
  colors_by_code  = FilamentColor.where(code: filament_color_codes).pluck(:code, :rgb).to_h
  default_palette = ["#4e79a7","#F28E2B","#E15759","#76B7B2","#59A14F","#EDC949","#AF7AA1","#FF9DA7","#9C755F","#BAB0AB"]
  chart_colors    = filament_color_codes.each_with_index.map { |code, i| colors_by_code[code].presence || default_palette[i % default_palette.length] }

  # --- Derived rollups for clearer storytelling (completions are non-cancelled) ---
  completed_by_category = report.category_counts
  completed_jobs_count  = completed_by_category.values.sum
  fdm_jobs              = report.fdm_count
  resin_jobs            = report.resin_count

  avg_prints_per_job    = completed_jobs_count.positive? ? (report.total_quantity.to_f / completed_jobs_count) : 0.0
  avg_filament_per_fdm  = fdm_jobs.positive?  ? (report.filament_grams.to_f / fdm_jobs) : 0.0
  avg_resin_per_resin   = resin_jobs.positive? ? (report.resin_ml.to_f / resin_jobs)     : 0.0

  popular_code, popular_count = filament_color_counts.max_by { |_, c| c } || [nil, 0]

  scan_completed_count = report.scan_completed_count
%>

<div class="card mb-4">
  <div class="card-header bg-light">
    <h3 class="mb-0">
      3D Print Stats
      <small class="text-muted">
        (<%= start_date.strftime("%Y-%m-%d") %> to <%= end_date.strftime("%Y-%m-%d") %>,
        <%= selected_location&.name || "All Locations" %>)
      </small>
    </h3>
  </div>

  <div class="card-body">

    <%= form_with url: rails_admin.stats_path, method: :get, local: true, class: "d-flex flex-wrap align-items-end gap-2 mb-3" do %>
      <div>
        <%= label_tag :start, "Start", class: "form-label fw-bold mb-1" %>
        <%= date_field_tag :start, start_date, class: "form-control" %>
      </div>
      <div>
        <%= label_tag :end, "End", class: "form-label fw-bold mb-1" %>
        <%= date_field_tag :end, end_date, class: "form-control" %>
      </div>
      <div>
        <%= label_tag :location, "Location", class: "form-label fw-bold mb-1" %>
        <%= select_tag :location,
                       options_for_select([["All Locations", ""]] + locations.pluck(:name, :code), location_code.to_s),
                       class: "form-select" %>
      </div>
      <%= submit_tag "Apply", class: "btn btn-primary" %>
      <div class="d-flex flex-wrap gap-1">
        <%= link_to "Yesterday", rails_admin.stats_path({ start: yesterday.begin, end: yesterday.end }.merge(location_params)), class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to "Last 7 Days", rails_admin.stats_path({ start: last_7_days.begin, end: last_7_days.end }.merge(location_params)), class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to "Last 30 Days", rails_admin.stats_path({ start: last_30_days.begin, end: last_30_days.end }.merge(location_params)), class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to "Current Month", rails_admin.stats_path({ start: curr_month.begin, end: curr_month.end }.merge(location_params)), class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to "Previous Month", rails_admin.stats_path({ start: prev_month.begin, end: prev_month.end }.merge(location_params)), class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to "Current Year", rails_admin.stats_path({ start: curr_year.begin, end: curr_year.end }.merge(location_params)), class: "btn btn-outline-secondary btn-sm" %>
        <%= link_to "Previous Year", rails_admin.stats_path({ start: prev_year.begin, end: prev_year.end }.merge(location_params)), class: "btn btn-outline-secondary btn-sm" %>
      </div>
    <% end %>

    <table class="table table-bordered mb-4">
      <tbody>
        <tr class="table-light">
          <th colspan="2">Submissions (created in date range)</th>
        </tr>
        <tr>
          <th>Print Orders Submitted</th>
          <td><%= report.orders_count %></td>
        </tr>
        <tr>
          <th>Cancelled (of those orders)</th>
          <td><%= report.cancelled_count %></td>
        </tr>
        <tr>
          <th>Rejected (of those orders)</th>
          <td><%= report.rejected_count %></td>
        </tr>
        <tr>
          <th>Distinct Patrons (submitted)</th>
          <td><%= report.distinct_patrons %></td>
        </tr>

        <tr class="table-light">
          <th colspan="2">Completions (finished in date range; excludes cancelled and rejected)</th>
        </tr>
        <tr>
          <th>Print Jobs Completed</th>
          <td>
            <%= completed_jobs_count %>
            <small class="text-muted">
              (<%= report.fdm_count %> FDM, <%= report.resin_count %> Resin, <%= report.multiple_count %> multi-color)
            </small>
          </td>
        </tr>
        <tr>
          <th>Scan Jobs Completed</th>
          <td><%= scan_completed_count %></td>
        </tr>
        <tr>
          <th>Total Prints</th>
          <td><%= report.total_quantity %></td>
        </tr>
        <tr>
          <th>Unique Designs</th>
          <td><%= report.unique_designs %></td>
        </tr>
        <tr>
          <th>Filament Used</th>
          <td><%= number_with_delimiter(report.filament_grams) %> g</td>
        </tr>
        <tr>
          <th>Resin Used</th>
          <td><%= number_with_delimiter(report.resin_ml) %> mL</td>
        </tr>
        <tr>
          <th>Most Popular Filament Color (by prints)</th>
          <td>
            <% if popular_code.present? %>
              <%= popular_code.titleize %> <small class="text-muted">(n=<%= popular_count %>)</small>
            <% else %>
              <span class="text-muted">(none this period)</span>
            <% end %>
          </td>
        </tr>

        <tr class="table-light">
          <th colspan="2">Averages (completions)</th>
        </tr>
        <tr>
          <th>Avg Prints per Completed Job</th>
          <td><%= number_with_precision(avg_prints_per_job, precision: 2) %></td>
        </tr>
        <tr>
          <th>Avg Filament per FDM Job</th>
          <td>
            <% if fdm_jobs.positive? %>
              <%= number_with_precision(avg_filament_per_fdm, precision: 1) %> g
              <small class="text-muted">(across <%= fdm_jobs %> FDM jobs)</small>
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </td>
        </tr>
        <tr>
          <th>Avg Resin per Resin Job</th>
          <td>
            <% if resin_jobs.positive? %>
              <%= number_with_precision(avg_resin_per_resin, precision: 1) %> mL
              <small class="text-muted">(across <%= resin_jobs %> resin jobs)</small>
            <% else %>
              <span class="text-muted">—</span>
            <% end %>
          </td>
        </tr>
      </tbody>
    </table>

    <!-- Completed jobs by Category -->
    <div class="card mb-4">
      <div class="card-header bg-light">
        <h3 class="mb-0">Completed Jobs by Category</h3>
      </div>
      <div class="card-body p-0">
        <table class="table mb-0">
          <thead>
            <tr>
              <th>Category</th>
              <th class="text-end"># of Jobs</th>
            </tr>
          </thead>
          <tbody>
            <% report.category_counts.each do |name, count| %>
              <tr>
                <td><%= name %></td>
                <td class="text-end"><%= count %></td>
              </tr>
            <% end %>
            <% if completed_jobs_count.zero? %>
              <tr><td colspan="2" class="text-muted">No completed jobs this period.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Charts Row -->
    <div class="card mb-4">
      <div class="row g-0 align-items-stretch">
        <div class="col-lg-8">
          <div class="p-2 d-flex flex-column h-100 justify-content-between">
            <div>
              <canvas id="printsPerDayChart" height="100"></canvas>
            </div>
            <div class="mt-4">
              <canvas id="filamentPerDayChart" height="100"></canvas>
            </div>
          </div>
        </div>
        <div class="col-lg-4 border-start">
          <div class="p-2 h-100 d-flex flex-column justify-content-center align-items-center">
            <canvas id="filamentColorChart" height="200"></canvas>
          </div>
        </div>
      </div>
    </div>

    <p class="text-muted small mb-0">
      <strong>Notes:</strong> “Submissions” reflect print-origin jobs created in the date range.
      “Completions” reflect jobs finished in the date range, excluding cancelled and rejected jobs.
      Scan completions use the preserved original request type, so scan requests still count as scans after conversion to print jobs.
      Quantities of 0/blank count as 1.
    </p>

  </div>

  <div class="card-footer text-end">
    <small>Stats refresh each time you open or filter this page.</small>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function() {
  window.__raCharts = window.__raCharts || {};

  function initDashboardCharts() {
    const ctx1 = document.getElementById('printsPerDayChart');
    const ctx2 = document.getElementById('filamentPerDayChart');
    const ctx3 = document.getElementById('filamentColorChart');
    if (!ctx1 || !ctx2 || !ctx3 || !window.Chart) return;

    ['printsPerDayChart','filamentPerDayChart','filamentColorChart'].forEach((k) => {
      if (window.__raCharts[k]) { window.__raCharts[k].destroy(); window.__raCharts[k] = null; }
    });

    window.__raCharts.printsPerDayChart = new window.Chart(ctx1.getContext('2d'), {
      type: 'line',
      data: {
        labels: <%= raw day_labels.to_json %>,
        datasets: [{
          label: 'Prints per Day (qty)',
          data: <%= raw prints_series.to_json %>,
          borderColor: '#3a8ee6',
          backgroundColor: 'rgba(54, 162, 235, 0.10)',
          borderWidth: 2,
          pointRadius: 2,
          fill: true,
          tension: 0.4
        }]
      },
      options: {
        responsive: true,
        plugins: { title: { display: true, text: 'Prints per Day (Completions)' }, legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
      }
    });

    window.__raCharts.filamentPerDayChart = new window.Chart(ctx2.getContext('2d'), {
      type: 'line',
      data: {
        labels: <%= raw day_labels.to_json %>,
        datasets: [{
          label: 'Filament Used (g)',
          data: <%= raw filament_series.to_json %>,
          borderColor: '#3ad29f',
          backgroundColor: 'rgba(58,210,159,0.10)',
          borderWidth: 2,
          pointRadius: 2,
          fill: true,
          tension: 0.4
        }]
      },
      options: {
        responsive: true,
        plugins: { title: { display: true, text: 'Filament Used Per Day (Completions)' }, legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
      }
    });

    window.__raCharts.filamentColorChart = new window.Chart(ctx3.getContext('2d'), {
      type: 'pie',
      data: {
        labels: <%= raw filament_color_labels.to_json %>,
        datasets: [{
          data: <%= raw filament_color_values.to_json %>,
          backgroundColor: <%= raw chart_colors.to_json %>
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'bottom' },
          title: { display: true, text: 'Filament Color Popularity (by prints)' }
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboardCharts, { once: true });
  } else {
    initDashboardCharts();
  }
  document.addEventListener('rails_admin.dom_ready', initDashboardCharts);
  document.addEventListener('turbo:load', initDashboardCharts);
})();
</script>
