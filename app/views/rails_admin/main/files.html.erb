<!-- app/views/rails_admin/main/files.html.erb -->

<style>
  /* Make file links stand out and show hover cursor */
  .file-link {
    display: inline-block;
    max-width: 400px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-weight: 600;
    color: #212529; /* Bootstrap dark text */
    transition: color 0.2s ease;
  }

  .file-link:hover,
  .file-link:focus {
    color: #0d6efd; /* Bootstrap primary blue */
    text-decoration: underline;
    cursor: pointer;
    outline: none;
  }

  /* Icon sizing and spacing */
  .file-icon {
    font-size: 1.5rem;
    color: #0d6efd;
    margin-right: 0.75rem;
    flex-shrink: 0;
  }

  /* Flex container to align file info */
  .file-item-content {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-grow: 1;
    min-width: 0;
  }

  /* File size styling */
  .file-size {
    color: #6c757d; /* Bootstrap muted */
    font-size: 0.875rem;
    white-space: nowrap;
  }

  /* Delete button tweaks */
  .btn-outline-danger {
    flex-shrink: 0;
  }
</style>

<div class="card mb-4 shadow-sm">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h3 class="mb-0">Files for Job #<%= @job.id %></h3>
    <span class="badge bg-primary text-white"><%= pluralize(@job.model_files.count, "file") %></span>
  </div>

  <div class="card-body">

    <% if @job.model_files.attached? %>
      <ul class="list-group mb-4">
        <% @job.model_files.each do |file| %>
          <% ext = File.extname(file.filename.to_s).downcase %>
          <li class="list-group-item d-flex align-items-center justify-content-between py-2 px-0 border-0 border-bottom">
            <div class="file-item-content">
              <!-- Use a generic icon to avoid missing icon names -->
              <i class="bi bi-file-earmark file-icon"></i>
              <%= link_to main_app.rails_blob_path(file, disposition: 'attachment'), class: "file-link", title: file.filename.to_s do %>
                <%= file.filename.to_s %>
              <% end %>
              <span class="file-size ms-auto"><%= number_to_human_size(file.byte_size) %></span>
            </div>
            <button type="button"
                    class="btn btn-sm btn-outline-danger ms-3"
                    data-bs-toggle="modal"
                    data-bs-target="#deleteFileModal_<%= file.id %>"
                    aria-label="Delete <%= file.filename %>">
              <i class="bi bi-trash"></i>
            </button>

            <!-- Delete Modal -->
            <div class="modal fade" id="deleteFileModal_<%= file.id %>" tabindex="-1" aria-labelledby="deleteFileModalLabel_<%= file.id %>" aria-hidden="true">
              <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                  <div class="modal-header">
                    <h5 class="modal-title" id="deleteFileModalLabel_<%= file.id %>">Delete file?</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                  </div>
                  <div class="modal-body">
                    Are you sure you want to delete <strong><%= file.filename %></strong>? This cannot be undone.
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <%= button_to rails_admin.files_path(model_name: 'job', id: @job.id, file_id: file.id),
                          method: :delete,
                          form: { class: "d-inline" },
                          class: "btn btn-danger" do %>
                      Yes, Delete
                    <% end %>
                  </div>
                </div>
              </div>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-muted mb-4">No files attached yet.</p>
    <% end %>

    <div class="card bg-light mb-0">
      <div class="card-body py-3">
        <%= form_with model: @job,
                      url: rails_admin.files_path(model_name: 'job', id: @job.id),
                      local: true, multipart: true, method: :post,
                      data: { turbo: false } do |f| %>
          <div class="row g-2 align-items-center">
            <div class="col-auto">
              <%= f.label :model_files, "Upload Model Files", class: "form-label mb-0" %>
            </div>
            <div class="col">
              <%= f.file_field :model_files,
                    multiple: true,
                    class: "form-control",
                    id: "admin_model_files",
                    accept: ".stl,.3mf,model/stl,application/sla,model/3mf,application/3mf,application/vnd.ms-package.3dmanufacturing-3dmodel" %>
              <div id="admin_model_files_feedback"
                   class="invalid-feedback d-block small mt-2"
                   style="display:none"
                   aria-live="polite"></div>
            </div>
            <div class="col-auto">
              <%= f.submit "Attach Files", class: "btn btn-primary" %>
            </div>
          </div>
          <div class="form-text ms-1">
            Allowed types: STL (<code>.stl</code>) or 3MF (<code>.3mf</code>).
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
(function(){
  // Small client-side guard (server already enforces allowlist)
  const input    = document.getElementById('admin_model_files');
  const feedback = document.getElementById('admin_model_files_feedback');
  if (!input) return;

  const allowedExts = ['.stl', '.3mf'];
  const blockedMimes = ['application/zip', 'application/x-zip-compressed', 'multipart/x-zip'];

  function isValid(file){
    const name = (file.name || '').toLowerCase();
    const type = (file.type || '').toLowerCase();
    const ext  = name.slice(name.lastIndexOf('.'));
    const extOk = allowedExts.includes(ext);
    const typeOk = !blockedMimes.includes(type);
    return extOk && typeOk;
  }

  function showError(msg){
    if (!feedback) return;
    feedback.style.display = '';
    feedback.textContent = msg;
    input.classList.add('is-invalid');
  }

  function clearError(){
    if (!feedback) return;
    feedback.style.display = 'none';
    feedback.textContent = '';
    input.classList.remove('is-invalid');
  }

  input.addEventListener('change', () => {
    const files = Array.from(input.files || []);
    if (!files.length) { clearError(); return; }

    const valid   = [];
    const invalid = [];
    files.forEach(f => (isValid(f) ? valid : invalid).push(f));

    if (invalid.length) {
      try {
        const dt = new DataTransfer();
        valid.forEach(f => dt.items.add(f));
        input.files = dt.files;
      } catch(_) {
        input.value = '';
      }
      const names = invalid.map(f => f.name).join(', ');
      showError('Only STL or 3MF files are allowed. Rejected: ' + names);
    } else {
      clearError();
    }
  });
})();
</script>
