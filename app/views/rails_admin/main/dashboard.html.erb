<%# app/views/rails_admin/main/dashboard.html.erb %>

<div class="container-fluid py-4">

  <div class="card mb-4">
    <div class="card-header bg-light">
      <h3 class="mb-0">Jobs in Status</h3>
    </div>
    <div class="card-body">
      <% subtitles = {
           'Pending'               => 'New jobs requested by patrons',
           'Information Requested' => 'Waiting on patron reply',
           'Response Received'     => 'Patron has responded',
           'Approved'              => 'Queued for printing',
           'In Progress'           => 'Currently printing',
           'Ready for pickup'      => 'Awaiting pickup',
           'Archived'              => 'Finished and closed',
           'Ongoing'               => 'Staff-only misc jobs',
           'Cancelled'             => 'Declined by patron',
           'Rejected'              => 'Terms violation or impossible',
           'Abandoned'             => 'Items never picked up'
         } %>

      <div class="row g-3">
        <% Status.order(:position).each do |status| %>
          <% link_scope = %w[archived cancelled rejected abandoned].include?(status.code) ? 'inactive' : 'active' %>
          <% count = Job.with_status(status.code).count %>

          <div class="col-6 col-md-4 col-lg-2">
            <%= link_to(
                  rails_admin.index_path(
                    model_name: 'job',
                    scope:      link_scope,
                    query:      '',
                    f: { status: { '0' => { o: 'like', v: status.code } } }
                  ),
                  class: "card h-100 text-decoration-none status-card #{'border-primary' if count.positive?}"
                ) do %>
              <div class="card-body d-flex flex-column">
                <h5 class="status-card-title mb-1"><%= status.name %></h5>
                <small class="text-muted mb-auto"><%= subtitles[status.name] %></small>
                <p class="status-card-count display-6 mb-0"><%= count %></p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <% ready_status = Status.find_by(code: 'ready_for_pickup') %>
  <% ready_jobs   = ready_status ? Job.where(status_id: ready_status.id).includes(:patron).order(Arel.sql('COALESCE(completion_date, created_at) ASC')) : Job.none %>
  <% pl_names     = PickupLocation.pluck(:code, :name).to_h %>

  <div class="card mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
      <h3 class="mb-0">Ready for Pickup</h3>
      <span class="badge bg-primary"><%= ready_jobs.size %></span>
    </div>

    <% if ready_jobs.any? %>
      <div class="table-responsive">
        <table class="table table-hover table-sm align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Job #</th>
              <th>Patron</th>
              <th>Location</th>
              <th>Completed</th>
              <th class="text-end">Cost</th>
              <th class="text-end">Action</th>
            </tr>
          </thead>
          <tbody>

            <% ready_jobs.each do |job| %>
              <% modal_id = "pickupModal_#{job.id}" %>
              <% form_id  = "pickup_form_#{job.id}" %>
              <% loc_name = pl_names[job.pickup_location] || job.pickup_location %>

              <tr>
                <td>
                  <%= link_to "##{job.id}",
                    url_for(controller: "rails_admin/main",
                            action:     "conversation",
                            model_name: "job",
                            id:         job.id) %>
                </td>

                <td><%= job.patron&.name.presence || job.patron&.email %></td>
                <td><%= loc_name %></td>
                <td><%= job.completion_date&.strftime("%Y-%m-%d") || "—" %></td>
                <td class="text-end">
                  <%= job.actual_cost.present? ? number_to_currency(job.actual_cost) : "—" %>
                </td>

                <td class="text-end">

                  <%# --- IMPORTANT: Hidden form that POSTS to custom RailsAdmin action --- %>
                  <form id="<%= form_id %>"
                        class="d-none"
                        action="<%= rails_admin.url_for(action: :picked_up, model_name: 'job', id: job.id) %>"
                        method="post">
                    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  </form>

                  <%# --- Button triggers confirmation modal --- %>
                  <button type="button"
                          class="btn btn-success btn-sm"
                          data-bs-toggle="modal"
                          data-bs-target="#<%= modal_id %>">
                    Picked Up
                  </button>

                  <div class="modal fade" id="<%= modal_id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content">

                        <div class="modal-header">
                          <h5 class="modal-title">Mark as Picked Up</h5>
                          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>

                        <div class="modal-body">

                          <p class="mb-3">
                            Confirm pickup for this job. It will be
                            <strong>archived immediately</strong>.
                          </p>

                          <ul class="list-group list-group-flush small">

                            <li class="list-group-item d-flex justify-content-between">
                              <span class="fw-bold">Patron:</span>
                              <span><%= job.patron&.name.presence || job.patron&.email || "Unknown" %></span>
                            </li>

                            <li class="list-group-item d-flex justify-content-between">
                              <span class="fw-bold">Location:</span>
                              <span><%= loc_name %></span>
                            </li>

                            <li class="list-group-item d-flex justify-content-between">
                              <span class="fw-bold">Completed:</span>
                              <span><%= job.completion_date&.strftime("%Y-%m-%d") || "—" %></span>
                            </li>

                            <li class="list-group-item d-flex justify-content-between">
                              <span class="fw-bold">Cost:</span>
                              <span>
                                <% if job.actual_cost.present? %>
                                  <%= number_to_currency(job.actual_cost) %>
                                <% elsif job.slicer_cost.present? %>
                                  <%= number_to_currency(job.slicer_cost) %>
                                <% else %>
                                  —
                                <% end %>
                              </span>
                            </li>

                          </ul>

                        </div>

                        <div class="modal-footer">
                          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cancel
                          </button>

                          <button type="button"
                                  class="btn btn-success"
                                  onclick="document.getElementById('<%= form_id %>').submit();">
                            Yes — Mark Picked Up
                          </button>
                        </div>

                      </div>
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="card-body">
        <em>No items are currently waiting for pickup.</em>
      </div>
    <% end %>
  </div>

  <% unread_by_job = Message.unread.joins(conversation: :job)
                         .select('jobs.id as job_id, jobs.patron_id, COUNT(messages.*) as cnt')
                         .group('jobs.id') %>

  <% if unread_by_job.any? %>
    <div class="card mb-4">
      <div class="card-header">
        <h3 class="mb-0">Unread Messages</h3>
      </div>
      <ul class="list-group list-group-flush">
        <% unread_by_job.each do |row| %>
          <% job = Job.find(row.job_id) %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <%= link_to "Job ##{job.id} — #{job.patron.name}",
                        url_for(
                          controller: "rails_admin/main",
                          action:     "conversation",
                          model_name: "job",
                          id:         job.id
                        ) %>
            <span class="badge bg-danger rounded-pill"><%= row.cnt %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="card mb-4">
      <div class="card-header"><h3 class="mb-0">No Unread Messages</h3></div>
      <h3 class="m-3">Hooray!</h3>
    </div>
  <% end %>

  <% my_mentions = Notification.unread.where(staff_user: current_staff_user).joins(message: { conversation: :job })
                     .select('jobs.id AS job_id, COUNT(notifications.*) AS cnt')
                     .group('jobs.id') %>

  <div class="card mb-4">
    <div class="card-header">
      <h3 class="mb-0">Mentions for You</h3>
    </div>

    <% if my_mentions.any? %>
      <ul class="list-group list-group-flush">
        <% my_mentions.each do |row| %>
          <% job = Job.find(row.job_id) %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <%= link_to "Job ##{job.id} — #{job.patron.name}",
                        url_for(
                          controller: "rails_admin/main",
                          action:     "conversation",
                          model_name: "job",
                          id:         job.id
                        ) %>
            <span class="badge bg-warning rounded-pill"><%= row.cnt %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="card-body">
        <em>No new mentions.</em>
      </div>
    <% end %>

    <div class="card-footer help-text">
      You can notify another staff member by tagging their @username in a
      <em>"Staff note only"</em> Job Message
    </div>
  </div>

  <div class="card mb-4">
    <div class="card-header bg-light">
      <h3 class="mb-0">Public Forms</h3>
    </div>
    <div class="card-body">
      <div class="btn-toolbar">
        <div class="btn-group me-2">
          <%= link_to '3D Print Request', main_app.submit_print_path, class: 'btn btn-primary', target: '_blank' %>
        </div>
        <div class="btn-group me-2">
          <%= link_to 'Scan Request', main_app.submit_scan_path, class: 'btn btn-primary', target: '_blank' %>
        </div>
        <div class="btn-group me-2">
          <%= link_to 'Fidget Request', main_app.submit_fidget_path, class: 'btn btn-primary', target: '_blank' %>
        </div>
        <div class="btn-group me-2">
          <%= link_to 'Assistive Request', main_app.submit_assistive_path, class: 'btn btn-primary', target: '_blank' %>
        </div>
        <div class="btn-group">
          <%= link_to 'Staff Print Request', main_app.submit_staff_path, class: 'btn btn-primary', target: '_blank' %>
        </div>
      </div>
    </div>
  </div>

</div>

<%= render 'rails_admin/main/job_statistics' %>
