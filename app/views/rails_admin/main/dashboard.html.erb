<%# app/views/rails_admin/main/dashboard.html.erb %>

<div class="container-fluid py-4">

  <div class="card mb-4">
    <div class="card-header bg-light">
      <h3 class="mb-0">Jobs in Status</h3>
    </div>
    <div class="card-body">
      <div class="row g-3">
        <% Status.order(:position).each do |status| %>
          <% link_scope = %w[archived cancelled].include?(status.code) ? 'inactive' : 'active' %>
          <% count      = Job.with_status(status.code).count %>

          <div class="col-sm-6 col-md-4 col-lg-3">
            <%= link_to(
                  rails_admin.index_path(
                    model_name: 'job',
                    scope:      link_scope,
                    query:      '',
                    f: {
                      status: {
                        '0' => {
                          o: 'like',
                          v: status.code
                        }
                      }
                    }
                  ),
                  class: "card h-100 text-decoration-none #{'border-primary' if count.positive?}"
                ) do %>
              <div class="card-body text-center">
                <h5 class="card-title mb-1"><%= status.name %></h5>
                <p class="display-6 mb-0"><%= count %></p>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <% unread_by_job = Message.unread.joins(conversation: :job)
                         .select('jobs.id as job_id, jobs.patron_id, COUNT(messages.*) as cnt')
                         .group('jobs.id') %>

  <% if unread_by_job.any? %>
    <div class="card mb-4">
      <div class="card-header">
        <h3 class="mb-0">Unread Messages</h3>
      </div>
      <ul class="list-group list-group-flush">
        <% unread_by_job.each do |row| %>
          <% job = Job.find(row.job_id) %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <%= link_to "Job ##{job.id} — #{job.patron.name}", 
                        url_for(
                          controller: "rails_admin/main",
                          action:     "conversation",
                          model_name: "job",
                          id:         job.id
                        ) %>
            <span class="badge bg-danger rounded-pill"><%= row.cnt %></span>
          </li>
        <% end %>
      </ul>
    </div>
  <% else %>
    <div class="card mb-4">
      <div class="card-header">
        <h3 class="mb-0">No Unread Messages</h3>
      </div>
      <h3 class="m-3">Hooray!</h3>
    </div>
  <% end %>

  <% my_mentions = Notification.unread.where(staff_user: current_staff_user).joins(message: { conversation: :job })
                     .select('jobs.id AS job_id, COUNT(notifications.*) AS cnt')
                     .group('jobs.id') %>

  <div class="card mb-4">
    <div class="card-header">
      <h3 class="mb-0">Mentions for You</h3>
    </div>
    <% if my_mentions.any? %>
      <ul class="list-group list-group-flush">
        <% my_mentions.each do |row| %>
          <% job = Job.find(row.job_id) %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <%= link_to "Job ##{job.id} — #{job.patron.name}",
                        url_for(
                          controller: "rails_admin/main",
                          action:     "conversation",
                          model_name: "job",
                          id:         job.id
                        ) %>
            <span class="badge bg-warning rounded-pill"><%= row.cnt %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <div class="card-body">
        <em>No new mentions.</em>
      </div>
    <% end %>
    <div class=" card-footer help-text">You can notify another staff member by tagging their @username in a <em>"Staff note only"</em> Job Message</div>
  </div>

  <div class="card mb-4">
    <div class="card-header bg-light">
      <h3 class="mb-0">Public Forms</h3>
    </div>
    <div class="card-body">
      <div class="btn-toolbar" role="toolbar" aria-label="Public form links">
        <div class="btn-group me-2" role="group" aria-label="Print">
          <%= link_to '3D Print Request', main_app.submit_print_path, class: 'btn btn-primary', target: '_blank' %>
        </div>
        <div class="btn-group me-2" role="group" aria-label="Scan">
          <%= link_to 'Scan Request', main_app.submit_scan_path, class: 'btn btn-primary', target: '_blank' %>
        </div>
        <div class="btn-group me-2" role="group" aria-label="Fidget">
          <%= link_to 'Fidget Request', main_app.submit_fidget_path, class: 'btn btn-primary', target: '_blank' %>
        </div>
        <div class="btn-group me-2" role="group" aria-label="Assistive">
          <%= link_to 'Assistive Request', main_app.submit_assistive_path, class: 'btn btn-primary', target: '_blank' %>
        </div>
        <div class="btn-group" role="group" aria-label="Staff">
          <%= link_to 'Staff Print Request', main_app.submit_staff_path, class: 'btn btn-primary', target: '_blank' %>
        </div>
      </div>
    </div>
  </div>

  <div class="print-lifecycle container my-4">
    <h1>3D Print Job Lifecycle</h1>
    <p>
      A clear process flow ensures staff and patrons understand the status transitions for each 3D print job.
    </p>
    <hr>

    <h2>Statuses Overview</h2>
    <ul>
      <li><strong>requested</strong> (0): Freshly requested jobs start here; awaiting staff slicing/clarification.</li>
      <li><strong>information_requested</strong> (1): Patron has been given price/weight estimate; awaiting their response.</li>
      <li><strong>response_received</strong> (2): Patron has replied to the estimate; staff to approve or cancel.</li>
      <li><strong>approved</strong> (3): Patron approved estimate; job is queued for printing.</li>
      <li><strong>in_progress</strong> (4): Job assigned to a specific printer and printing has started.</li>
      <li><strong>ready_for_pickup</strong> (5): Print finished, post‐processed, and weighed; patron notified.</li>
      <li><strong>archived</strong> (6): Patron picked up the print; job closed out and archived.</li>
      <li><strong>ongoing</strong> (7): Internal/staff‐only filler prints to keep printers busy.</li>
      <li><strong>cancelled</strong> (8): Patron declined the estimate or job cancelled by staff.</li>
    </ul>
    <hr>

    <div class="accordion" id="lifecycleAccordion">

      <!-- 1. requested → information_requested -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="heading-requested">
          <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-requested" aria-expanded="true" aria-controls="collapse-requested">
            1. requested → information_requested
          </button>
        </h2>
        <div id="collapse-requested" class="accordion-collapse collapse show" aria-labelledby="heading-requested" data-bs-parent="#lifecycleAccordion">
          <div class="accordion-body">
            <ul>
              <li><strong>Trigger:</strong> Patron submits a new print request (status set to <em>requested</em>).</li>
              <li><strong>Staff Actions:</strong>
                <ul>
                  <li>Review model (scale, print type, printability).</li>
                  <li>Slice to generate estimated filament weight/time.</li>
                  <li>If clarification needed, contact patron via conversation.</li>
                  <li>Record <em>slicer_cost</em> and <em>slicer_weight</em>.</li>
                </ul>
              </li>
              <li><strong>Automated:</strong>
                <ul>
                  <li>Automated message with cost/weight estimate sent via JobMailer.</li>
                  <li>Update status to <em>information_requested</em>.</li>
                </ul>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 2. information_requested → response_received -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="heading-info">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-info" aria-expanded="false" aria-controls="collapse-info">
            2. information_requested → response_received
          </button>
        </h2>
        <div id="collapse-info" class="accordion-collapse collapse" aria-labelledby="heading-info" data-bs-parent="#lifecycleAccordion">
          <div class="accordion-body">
            <ul>
              <li><strong>Trigger:</strong> Patron replies to the estimate message.</li>
              <li><strong>Staff Actions:</strong>
                <ul>
                  <li>Review patron’s response.</li>
                </ul>
              </li>
              <li><strong>Automated:</strong> Status changed to <em>response_received</em>
            </ul>
          </div>
        </div>
      </div>

      <!-- 3. response_received → {approved / cancelled} -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="heading-response">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-response" aria-expanded="false" aria-controls="collapse-response">
            3. response_received → {approved / cancelled}
          </button>
        </h2>
        <div id="collapse-response" class="accordion-collapse collapse" aria-labelledby="heading-response" data-bs-parent="#lifecycleAccordion">
          <div class="accordion-body">
            <ul>
              <li><strong>Possible Outcomes:</strong>
                <ul>
                  <li><em>approved</em>: Patron accepts estimate.</li>
                  <li><em>cancelled</em>: Patron declines or staff cancels.</li>
                </ul>
              </li>
              <li><strong>Staff Actions (on approval):</strong>
                <ul>
                  <li>Update status to <em>approved</em>.</li>
                  <li>Queue job for printing.</li>
                </ul>
              </li>
              <li><strong>Staff Actions (on cancellation):</strong>
                <ul>
                  <li>Update status to <em>cancelled</em>.</li>
                  <li>Confirm cancellation with patron by sending a message. (automate this?)</li>
                </ul>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 4. approved → in_progress -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="heading-approved">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-approved" aria-expanded="false" aria-controls="collapse-approved">
            4. approved → in_progress
          </button>
        </h2>
        <div id="collapse-approved" class="accordion-collapse collapse" aria-labelledby="heading-approved" data-bs-parent="#lifecycleAccordion">
          <div class="accordion-body">
            <ul>
              <li><strong>Trigger:</strong> Printer becomes available and staff starts the print.</li>
              <li><strong>Actions:</strong>
                <ul>
                  <li>Assign job to a printer.</li>
                  <li>Update status to <em>in_progress</em>.</li>
                </ul>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 5. in_progress → ready_for_pickup -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="heading-progress">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-progress" aria-expanded="false" aria-controls="collapse-progress">
            5. in_progress → ready_for_pickup
          </button>
        </h2>
        <div id="collapse-progress" class="accordion-collapse collapse" aria-labelledby="heading-progress" data-bs-parent="#lifecycleAccordion">
          <div class="accordion-body">
            <ul>
              <li><strong>Trigger:</strong> Print run completes successfully.</li>
              <li><strong>Actions:</strong>
                <ul>
                  <li>Post‐process (support removal, curing, cleaning).</li>
                  <li>Weigh actual filament (or resin volume).</li>
                  <li>Record completion date and actual weight.</li>
                </ul>
              </li>
              <li><strong>Automated:</strong>
                <ul>
                  <li>Update status to <em>ready_for_pickup</em>.</li>
                  <li>Notify patron via JobMailer the job is ready, and the actual cost.</li>
                </ul>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 6. ready_for_pickup → archived -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="heading-ready">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-ready" aria-expanded="false" aria-controls="collapse-ready">
            6. ready_for_pickup → archived
          </button>
        </h2>
        <div id="collapse-ready" class="accordion-collapse collapse" aria-labelledby="heading-ready" data-bs-parent="#lifecycleAccordion">
          <div class="accordion-body">
            <ul>
              <li><strong>Trigger:</strong> Patron picks up the finished print.</li>
              <li><strong>Actions:</strong>
                <ul>
                  <li>Staff enters Pickup Date.</li>
                </ul>
              </li>
              <li><strong>Automated:</strong>
                <ul>
                  <li>Job is marked as <em>archived</em>.</li>
                  <li>Optionally send a feedback survey or follow-up message.</li>
                </ul>
            </ul>
          </div>
        </div>
      </div>

      <!-- 7. ongoing (staff-only) -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="heading-ongoing">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-ongoing" aria-expanded="false" aria-controls="collapse-ongoing">
            7. ongoing (staff-only)
          </button>
        </h2>
        <div id="collapse-ongoing" class="accordion-collapse collapse" aria-labelledby="heading-ongoing" data-bs-parent="#lifecycleAccordion">
          <div class="accordion-body">
            <ul>
              <li><strong>Usage:</strong> Internal filler prints when no patron jobs are queued.</li>
              <li><strong>Actions:</strong>
                <ul>
                  <li>Staff manually assign or create <em>ongoing</em> jobs for assistive/fidget devices or programs.</li>
                  <li>For each object printed, increase Quantity field to record how many have been printed.</li>
                </ul>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 8. cancelled -->
      <div class="accordion-item">
        <h2 class="accordion-header" id="heading-cancelled">
          <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-cancelled" aria-expanded="false" aria-controls="collapse-cancelled">
            8. cancelled
          </button>
        </h2>
        <div id="collapse-cancelled" class="accordion-collapse collapse" aria-labelledby="heading-cancelled" data-bs-parent="#lifecycleAccordion">
          <div class="accordion-body">
            <ul>
              <li><strong>Trigger:</strong> Patron declines during <em>response_received</em> or staff cancels otherwise.</li>
              <li><strong>Actions:</strong>
                <ul>
                  <li>Update status to <em>cancelled</em>.</li>
                  <li>Retain record for reporting; do not queue or print.</li>
                </ul>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
