<% content_for :title, "Conversation · Job ##{@job.id}" %>
<%= link_to "← Jobs", admin_jobs_path, class: "admin-muted text-sm hover:underline" %>
<div class="mb-5 mt-2 flex flex-wrap items-center justify-between gap-3"><div><h1 class="text-3xl font-semibold tracking-tight">Job #<%= @job.id %> conversation</h1><p class="admin-muted mt-2"><%= @job.patron.name.presence || @job.patron.email %> · <%= @job.status.name %></p></div></div>
<%= render "navigation" %>
<div class="grid items-start gap-6 xl:grid-cols-3">
  <section class="space-y-4 xl:col-span-2" aria-label="Messages">
    <% if @messages.any? %>
      <% @messages.each do |message| %>
        <article class="admin-card <%= 'border-amber-200 bg-amber-50' if message.staff_note_only? %>">
          <div class="mb-3 flex flex-wrap items-start justify-between gap-2"><div><span class="font-semibold"><%= message.author&.name.presence || message.author_type %></span><span class="admin-muted ml-2 text-xs"><%= message.author_type == "StaffUser" ? "Staff" : "Patron" %></span><% if message.staff_note_only? %><span class="admin-badge ml-2">Staff note</span><% end %></div><time class="admin-muted text-xs" datetime="<%= message.created_at.iso8601 %>"><%= message.created_at.strftime("%b %-d, %Y · %-I:%M %p") %></time></div>
          <div class="space-y-3 break-words text-sm leading-relaxed"><%= simple_format(message.body) %></div>
          <% if message.images.attached? %><div class="mt-4 flex flex-wrap gap-3"><% message.images.each do |image| %><%= link_to rails_blob_path(image, disposition: "attachment"), class: "text-sm text-brand-700 hover:underline" do %><% if image.variable? %><%= image_tag image.variant(resize_to_limit: [250, 250]), alt: image.filename.to_s, class: "mb-2 max-w-full rounded-lg" %><% end %><%= image.filename %><% end %><% end %></div><% end %>
        </article>
      <% end %>
    <% else %><div class="admin-card admin-muted py-12 text-center">No messages yet.</div><% end %>
  </section>
  <section class="admin-card"><h2 class="mb-5 text-lg font-semibold">Add a message</h2><%= render "admin/shared/errors", record: @message %>
    <%= form_with url: conversation_admin_job_path(@job), scope: :conversation, method: :post, multipart: true, class: "space-y-5" do |f| %>
      <div class="admin-field"><%= f.label :message_body, "Message", class: "admin-label" %><%= f.text_area :message_body, value: @message.body, rows: 8, required: true, class: "admin-input", placeholder: "Write a reply or staff note…" %></div>
      <label class="flex items-start gap-3"><%= f.check_box :staff_note_only, checked: @message.staff_note_only?, class: "mt-1 rounded border-slate-300" %><span class="text-sm">Staff note<span class="admin-muted mt-1 block">Visible only to staff. Using @username automatically makes a message a staff note and notifies that person.</span></span></label>
      <div class="admin-field"><%= f.label :images, "Attachments", class: "admin-label" %><%= f.file_field :images, multiple: true, accept: "image/*", class: "admin-input" %></div>
      <%= f.submit "Send message", class: "admin-btn admin-btn-primary" %>
    <% end %>
  </section>
</div>
