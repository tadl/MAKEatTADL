<%= render "admin/shared/errors", record: @job %>
<%= form_with model: @job, scope: :job, url: @job.persisted? ? admin_job_path(@job) : admin_jobs_path, multipart: true, class: "space-y-6" do |f| %>
  <section class="admin-card"><h2 class="mb-5 text-lg font-semibold">Request</h2><div class="grid gap-5 sm:grid-cols-2">
    <% if @job.new_record? %>
      <%= f.hidden_field :type %>
      <% if @selected_model %><%= f.hidden_field :printable_model_id %><p class="rounded-lg bg-blue-50 p-3 text-sm text-blue-900 sm:col-span-2">Using library model: <strong><%= @selected_model.name %></strong>. Its saved model file will be attached to the new job.</p><% end %>
      <div class="admin-field sm:col-span-2"><%= f.label :patron_id, "Patron", class: "admin-label" %><%= f.select :patron_id, @patrons.map { |patron| ["#{patron.name.presence || 'Unnamed patron'} — #{patron.email}", patron.id] }, { include_blank: "Choose a patron" }, class: "admin-input", required: true %><p class="admin-muted mt-1 text-sm">Create a patron in the Patrons section first if needed.</p></div>
    <% else %>
      <div><span class="admin-label">Patron</span><p class="mt-2"><%= @job.patron.name.presence || @job.patron.email %> <span class="admin-muted">(<%= @job.patron.email %>)</span></p></div>
      <div><span class="admin-label">Job type</span><p class="mt-2"><%= @job.is_a?(ScanJob) ? "Scan" : "Print" %></p></div>
    <% end %>
    <div class="admin-field"><%= f.label :status_id, "Status", class: "admin-label" %><%= f.collection_select :status_id, @statuses, :id, :name, {}, class: "admin-input", required: true %></div>
    <div class="admin-field"><%= f.label :category_id, "Category", class: "admin-label" %><%= f.collection_select :category_id, @categories, :id, :name, {}, class: "admin-input", required: true %></div>
    <div class="admin-field"><%= f.label :pickup_location, "Pickup location", class: "admin-label" %><%= f.collection_select :pickup_location, @active_locations, :code, :name, { include_blank: "Choose a location" }, class: "admin-input", required: true %></div>
    <div class="admin-field sm:col-span-2"><%= f.label :notes, "Request notes", class: "admin-label" %><%= f.text_area :notes, rows: 4, class: "admin-input" %></div>
  </div></section>

  <% if @job.is_a?(PrintJob) %>
    <section class="admin-card"><h2 class="mb-5 text-lg font-semibold">Print setup</h2><div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
      <div class="admin-field"><%= f.label :assigned_printer_id, "Assigned printer", class: "admin-label" %><%= f.collection_select :assigned_printer_id, @printers, :id, :name, { include_blank: "Unassigned" }, class: "admin-input" %><p class="admin-muted mt-1 text-sm">Assigning a printer can move this job to In progress.</p></div>
      <div class="admin-field"><%= f.label :print_type_code, "Print type", class: "admin-label" %><%= f.collection_select :print_type_code, @print_types, :code, :name, { include_blank: "Choose a type" }, class: "admin-input" %><p class="admin-muted mt-1 text-sm">Updated automatically when the printer changes.</p></div>
      <div class="admin-field"><%= f.label :filament_color, "Filament color", class: "admin-label" %><%= f.collection_select :filament_color, @colors, :code, :name, { include_blank: "Choose a color" }, class: "admin-input" %></div>
      <div class="admin-field"><%= f.label :quantity, "Quantity", class: "admin-label" %><%= f.number_field :quantity, min: 1, step: 1, class: "admin-input" %></div>
      <div class="admin-field"><%= f.label :print_time_estimate_hm, "Estimated duration", class: "admin-label" %><%= f.text_field :print_time_estimate_hm, placeholder: "2:30", class: "admin-input" %><p class="admin-muted mt-1 text-sm">Hours:minutes, or a number of minutes.</p></div>
      <div class="admin-field sm:col-span-2 xl:col-span-3"><%= f.label :url, "Model URL", class: "admin-label" %><%= f.url_field :url, class: "admin-input", placeholder: "https://example.org/model" %></div>
      <div class="sm:col-span-2 xl:col-span-3"><label class="flex items-start gap-3"><%= f.check_box :print_notify, class: "mt-1 rounded border-slate-300" %><span>Notify patron when printing starts<span class="admin-muted mt-1 block text-sm">Sends an email and portal message when a job moves to In progress on a public printer.</span></span></label></div>
    </div></section>

    <section class="admin-card"><h2 class="mb-2 text-lg font-semibold">Estimates and completion</h2><p class="admin-muted mb-5 text-sm">Entering estimated weight for the first time sends a quote for patron jobs. Entering actual weight or resin volume for the first time marks the job ready and emails the patron. Ongoing jobs suppress these automations.</p>
      <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3">
        <div class="admin-field"><%= f.label :slicer_weight, "Estimated weight (g)", class: "admin-label" %><%= f.number_field :slicer_weight, min: 0, step: 0.01, class: "admin-input" %></div>
        <div><span class="admin-label">Estimated cost</span><p class="mt-3 font-medium"><%= @job.slicer_cost.present? ? number_to_currency(@job.slicer_cost) : "Calculated from weight" %></p></div>
        <div class="admin-field"><%= f.label :actual_weight, "Actual weight (g)", class: "admin-label" %><%= f.number_field :actual_weight, min: 0, step: 0.01, class: "admin-input" %></div>
        <div class="admin-field"><%= f.label :resin_volume_ml, "Resin volume (mL)", class: "admin-label" %><%= f.number_field :resin_volume_ml, min: 0, step: 0.01, class: "admin-input" %></div>
        <div><span class="admin-label">Actual cost</span><p class="mt-3 font-medium"><%= @job.actual_cost.present? ? number_to_currency(@job.actual_cost) : "Calculated from material used" %></p></div>
        <div class="admin-field"><%= f.label :completion_date, "Completion date", class: "admin-label" %><%= f.date_field :completion_date, class: "admin-input" %></div>
        <div class="admin-field"><%= f.label :pickup_date, "Pickup date", class: "admin-label" %><%= f.date_field :pickup_date, class: "admin-input" %><p class="admin-muted mt-1 text-sm">Setting a pickup date archives the job.</p></div>
      </div>
    </section>
  <% else %>
    <section class="admin-card"><h2 class="mb-5 text-lg font-semibold">Scan details</h2><div class="space-y-5">
      <label class="flex items-center gap-3"><%= f.check_box :spray_ok, class: "rounded border-slate-300" %><span>Patron permits scanning spray or powder</span></label>
      <div class="admin-field"><%= f.label :scan_image, "Reference photo", class: "admin-label" %><% if @job.scan_image.attached? %><p class="mb-2 text-sm"><%= link_to @job.scan_image.filename, rails_blob_path(@job.scan_image, disposition: "attachment"), class: "text-blue-700 hover:underline" %></p><% end %><%= f.file_field :scan_image, accept: ".png,.jpg,.jpeg,.heic,.heif", class: "admin-input" %><p class="admin-muted mt-1 text-sm">PNG, JPEG, or HEIC. A new upload replaces the existing photo.</p></div>
    </div></section>
  <% end %>

  <% if @job.new_record? %><section class="admin-card"><h2 class="mb-5 text-lg font-semibold">Model files</h2><div class="admin-field"><%= f.label :model_files, "Upload STL or 3MF files", class: "admin-label" %><%= f.file_field :model_files, multiple: true, accept: ".stl,.3mf", class: "admin-input" %></div></section><% end %>
  <div class="flex flex-wrap gap-3"><%= f.submit @job.persisted? ? "Save changes" : "Create job", class: "admin-btn admin-btn-primary" %><%= link_to "Cancel", @job.persisted? ? admin_job_path(@job) : admin_jobs_path, class: "admin-btn admin-btn-secondary" %></div>
<% end %>
