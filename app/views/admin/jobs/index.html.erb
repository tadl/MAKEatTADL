<% content_for :title, "Jobs" %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div><h1 class="text-3xl font-semibold tracking-tight">Jobs</h1><p class="admin-muted mt-2">Review requests and keep work moving.</p></div>
  <div class="flex flex-wrap gap-2">
    <% if can?(:export, Job) %><details class="relative"><summary class="admin-btn admin-btn-secondary cursor-pointer">Export</summary><div class="absolute right-0 z-10 mt-2 min-w-36 rounded-xl border border-slate-200 bg-white p-2 shadow-lg"><% %w[csv json xml].each do |format| %><%= link_to format.upcase, export_admin_jobs_path(request.query_parameters.except("page").merge(format: format)), class: "block rounded-lg px-4 py-2 text-sm hover:bg-slate-50", data: { turbo: false } %><% end %></div></details><% end %>
    <% if can?(:create, Job) %><%= link_to "New job", new_admin_job_path, class: "admin-btn admin-btn-primary" %><% end %>
  </div>
</div>

<nav class="mb-5 flex flex-wrap gap-2" aria-label="Job groups">
  <% [["Active", "active"], ["Inactive", "inactive"], ["Ongoing", "ongoing"], ["All jobs", "all"]].each do |label, value| %>
    <% selected = (params[:scope].presence || "active") == value %>
    <%= link_to label, admin_jobs_path(request.query_parameters.except("page").merge(scope: value)), class: "admin-btn #{selected ? 'admin-btn-primary' : 'admin-btn-secondary'}", aria: { current: selected ? "page" : nil } %>
  <% end %>
</nav>

<section class="admin-card mb-5" aria-label="Filter jobs">
  <%= form_with url: admin_jobs_path, method: :get, class: "grid gap-4 sm:grid-cols-2 xl:grid-cols-4" do |f| %>
    <%= hidden_field_tag :scope, params[:scope].presence || "active" %>
    <%= hidden_field_tag :per_page, @per_page %>
    <div class="admin-field sm:col-span-2"><%= f.label :q, "Search jobs", class: "admin-label" %><%= f.search_field :q, value: params[:q], placeholder: "Job number, patron name, email, or model URL", class: "admin-input" %></div>
    <div class="admin-field"><%= f.label :status_id, "Status", class: "admin-label" %><%= f.select :status_id, options_from_collection_for_select(@statuses, :id, :name, params[:status_id]), { include_blank: "All statuses" }, class: "admin-input" %></div>
    <div class="admin-field"><%= f.label :category_id, "Category", class: "admin-label" %><%= f.select :category_id, options_from_collection_for_select(@categories, :id, :name, params[:category_id]), { include_blank: "All categories" }, class: "admin-input" %></div>
    <div class="admin-field"><%= f.label :type, "Job type", class: "admin-label" %><%= f.select :type, options_for_select([["Print", "PrintJob"], ["Scan", "ScanJob"]], params[:type]), { include_blank: "Print and scan" }, class: "admin-input" %></div>
    <div class="admin-field"><%= f.label :pickup_location, "Pickup location", class: "admin-label" %><%= f.select :pickup_location, options_from_collection_for_select(@locations, :code, :name, params[:pickup_location]), { include_blank: "All locations" }, class: "admin-input" %></div>
    <div class="admin-field"><%= f.label :from, "Received from", class: "admin-label" %><%= f.date_field :from, value: params[:from], class: "admin-input" %></div>
    <div class="admin-field"><%= f.label :to, "Received through", class: "admin-label" %><%= f.date_field :to, value: params[:to], class: "admin-input" %></div>
    <div class="flex flex-wrap items-center gap-2 sm:col-span-2 xl:col-span-4"><%= f.submit "Apply filters", class: "admin-btn admin-btn-primary" %><%= link_to "Clear", admin_jobs_path(per_page: @per_page), class: "admin-btn admin-btn-secondary" %><span class="admin-muted"><%= pluralize(@total_count, "job") %></span></div>
  <% end %>
</section>

<%= render "admin/shared/pagination", position: "top" %>
<% selectable = can?(:destroy, Job) && @jobs.any? %>
<div data-controller="bulk-selection" data-action="change->bulk-selection#update">
<% if selectable %>
  <%= form_with url: bulk_destroy_admin_jobs_path, method: :post, id: "bulk-jobs", data: { turbo_confirm: "Delete the selected jobs and their conversations? This cannot be undone." } do |f| %>
    <div class="mb-3 flex flex-wrap items-center justify-end gap-3" data-bulk-selection-target="actions" hidden><span class="admin-muted" data-bulk-selection-target="count">0 selected</span><%= f.submit "Delete selected", class: "admin-btn admin-btn-danger" %></div>
  <% end %>
<% end %>
<div class="admin-card overflow-x-auto p-0">
  <table class="admin-table">
    <thead><tr>
      <% if selectable %><th scope="col" data-row-link-ignore><%= tag.input type: "checkbox", class: "rounded border-slate-300", aria: { label: "Select all visible jobs" }, data: { bulk_selection_target: "all", action: "change->bulk-selection#toggleAll" } %></th><% end %>
      <% [["Job", "id"], ["Patron", "patron"], ["Status", "status"], ["Category", "category"], ["Type", "type"], ["Pickup location", "pickup_location"], ["Received", "received"]].each do |label, key| %>
        <th scope="col"><%= link_to label, admin_jobs_path(request.query_parameters.except("page").merge(sort: key, direction: params[:sort] == key && params[:direction] == "asc" ? "desc" : "asc")) %></th>
      <% end %>
    </tr></thead>
    <tbody>
      <% @jobs.each do |job| %>
        <tr class="cursor-pointer focus-within:bg-brand-50" data-controller="row-link" data-action="click->row-link#open">
          <% if selectable %><td class="cursor-default" data-row-link-ignore><%= check_box_tag "ids[]", job.id, false, form: "bulk-jobs", aria: { label: "Select job #{job.id}" }, class: "rounded border-slate-300", data: { bulk_selection_target: "item" } %></td><% end %>
          <th scope="row"><%= link_to "##{job.id}", admin_job_path(job), class: "font-semibold text-brand-700 hover:underline", data: { row_link_target: "link" } %></th>
          <td><%= job.patron.name.presence || job.patron.email %><div class="admin-muted text-xs"><%= job.patron.email %></div></td>
          <td><%= admin_status_badge(job.status) %></td>
          <td><%= job.category.name %></td><td><%= job.is_a?(ScanJob) ? "Scan" : "Print" %></td>
          <td><%= @location_names[job.pickup_location] || job.pickup_location %></td>
          <td class="whitespace-nowrap"><%= job.created_at.strftime("%b %-d, %Y") %><div class="admin-muted text-xs"><%= job.created_at.strftime("%-I:%M %p") %></div></td>
        </tr>
      <% end %>
      <% if @jobs.empty? %><tr><td colspan="<%= selectable ? 8 : 7 %>" class="py-12 text-center admin-muted">No jobs match these filters.</td></tr><% end %>
    </tbody>
  </table>
</div>
</div>
<%= render "admin/shared/pagination", position: "bottom" %>
