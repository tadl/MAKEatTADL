<div class="overflow-x-auto">
  <table class="admin-table">
    <thead>
      <tr>
        <% if selectable %><th scope="col"><span class="sr-only">Select</span></th><% end %>
        <th scope="col">Name</th>
        <th scope="col">Email</th>
        <th scope="col">Jobs</th>
        <th scope="col"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% @patrons.each do |patron| %>
        <tr>
          <% if selectable %>
            <td><%= check_box_tag "ids[]", patron.id, false, aria: { label: "Select #{patron.name.presence || patron.email}" } %></td>
          <% end %>
          <td><%= link_to patron.name.presence || "Unnamed patron", admin_patron_path(patron), class: "font-medium text-teal-700 hover:underline" %></td>
          <td><%= patron.email %></td>
          <td><%= @job_counts.fetch(patron.id, 0) %></td>
          <td><%= link_to "View", admin_patron_path(patron), class: "admin-btn" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
