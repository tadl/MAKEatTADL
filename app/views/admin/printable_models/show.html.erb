<div class="admin-page-header">
  <div><h1><%= @model.name %></h1><p><%= @model.code %> · <%= library_collection_label(@model.category) %></p></div>
  <div class="admin-actions">
    <% if can?(:create, Job) && @model.model_file.attached? %><%= link_to "Print again", new_admin_job_path(printable_model_id: @model.id), class: "admin-btn admin-btn-primary" %><% end %>
    <% if can?(:update, @model) %><%= link_to "Edit model", edit_admin_printable_model_path(@model), class: "admin-btn" %><% end %>
    <%= link_to "All models", admin_printable_models_path, class: "admin-btn" %>
  </div>
</div>
<div class="grid items-start gap-6 xl:grid-cols-[minmax(0,2fr)_minmax(280px,1fr)]">
  <section class="admin-card">
    <% uploaded_preview = @model.preview_image.attached? && @model.preview_image.content_type.in?(%w[image/jpeg image/png image/webp]) %>
    <% if uploaded_preview %>
      <%= image_tag rails_blob_path(@model.preview_image), alt: @model.name, class: "mb-6 max-h-80 w-full rounded-lg bg-slate-50 object-contain" %>
    <% elsif @model.model_file.attached? %>
      <%= image_tag thumbnail_admin_printable_model_path(@model), alt: @model.name, class: "mb-6 max-h-80 w-full rounded-lg bg-slate-50 object-contain" %>
    <% else %>
      <div class="mb-6 rounded-lg bg-slate-50 px-5 py-10 text-center"><%= admin_icon(:models, classes: "mx-auto h-12 w-12 text-slate-300") %><p class="mt-3 font-medium text-slate-700">No model file</p><p class="admin-muted mt-2">Upload a model file before printing this design again.</p></div>
    <% end %>
    <h2>Model file</h2>
    <% if @model.model_file.attached? %><%= render "admin/shared/model_files", files: [@model.model_file] %><% elsif uploaded_preview %><p class="admin-muted">No model file is attached. Upload a model file before printing this design again.</p><% end %>
  </section>
  <section class="admin-card">
    <h2>Printing notes</h2>
    <dl class="mb-5 space-y-4"><div><dt class="admin-muted">Default weight per copy</dt><dd class="mt-1 text-sm font-medium"><%= @model.weight_grams.present? ? "#{@model.weight_grams} g" : "Not recorded" %></dd></div></dl>
    <div class="whitespace-pre-wrap text-sm leading-7 text-slate-600"><%= @model.notes.presence || "No notes recorded." %></div>
    <% if can?(:destroy, @model) %><div class="mt-7 border-t border-slate-100 pt-5"><%= button_to "Delete model", admin_printable_model_path(@model), method: :delete, class: "admin-btn admin-btn-danger", data: { turbo_confirm: "Delete this model? This cannot be undone." } %></div><% end %>
  </section>
</div>
<section class="admin-card mt-6">
  <h2>Recent print history</h2>
  <% if @jobs.any? %><div class="overflow-x-auto"><table class="admin-table"><thead><tr><th>Job</th><th>Patron</th><th>Status</th><th>Received</th><th>Quantity</th></tr></thead><tbody><% @jobs.each do |job| %><tr><td><%= link_to "##{job.id}", admin_job_path(job) %></td><td><%= job.patron.name.presence || job.patron.email %></td><td><%= admin_status_badge(job.status) %></td><td><%= job.created_at.to_date.to_fs(:long) %></td><td><%= job.quantity.presence || 1 %></td></tr><% end %></tbody></table></div><% else %><p class="admin-muted">No jobs are linked to this saved model yet.</p><% end %>
</section>
