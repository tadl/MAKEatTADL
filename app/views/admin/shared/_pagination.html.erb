<% position = local_assigns.fetch(:position, "bottom") %>
<nav aria-label="Pagination <%= position %>" class="my-5 flex flex-wrap items-center justify-between gap-4">
  <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
    <p class="admin-muted text-sm">
      <% if @total_count.positive? %>
        Showing <%= number_with_delimiter((@page - 1) * @per_page + 1) %>–<%= number_with_delimiter([@page * @per_page, @total_count].min) %> of <%= number_with_delimiter(@total_count) %>
      <% else %>
        No results
      <% end %>
    </p>
    <%= form_with url: request.path, method: :get, class: "flex items-center gap-2", data: { controller: "auto-submit", action: "change->auto-submit#submit" } do %>
      <%= admin_pagination_hidden_fields %>
      <%= label_tag "per-page-#{position}", "Per page", class: "text-sm text-slate-600" %>
      <%= select_tag :per_page, options_for_select(Admin::BaseController::PAGE_SIZES, @per_page), id: "per-page-#{position}", class: "admin-input w-auto" %>
      <noscript><button type="submit" class="admin-btn admin-btn-small">Apply</button></noscript>
    <% end %>
  </div>
  <div class="flex flex-wrap items-center gap-1">
    <% if @page > 1 %>
      <%= link_to "< Prev", admin_pagination_path(@page - 1), rel: "prev", class: "admin-btn px-3" %>
    <% else %>
      <span class="admin-btn pointer-events-none px-3 text-slate-400" aria-disabled="true">&lt; Prev</span>
    <% end %>
    <% admin_pagination_pages(current_page: @page, total_pages: @total_pages).each do |page| %>
      <% if page.nil? %>
        <span class="px-1 text-slate-500" aria-hidden="true">…</span>
      <% elsif page == @page %>
        <span class="admin-btn pointer-events-none min-w-10 border-brand-700 bg-brand-700 px-3 text-white" aria-current="page" aria-disabled="true"><%= page %></span>
      <% else %>
        <%= link_to page, admin_pagination_path(page), class: "admin-btn min-w-10 px-3", aria: { label: "Page #{page}" } %>
      <% end %>
    <% end %>
    <% if @page < @total_pages %>
      <%= link_to "Next >", admin_pagination_path(@page + 1), rel: "next", class: "admin-btn px-3" %>
    <% else %>
      <span class="admin-btn pointer-events-none px-3 text-slate-400" aria-disabled="true">Next &gt;</span>
    <% end %>
  </div>
</nav>
