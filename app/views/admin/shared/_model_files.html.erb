<% if files.any? %>
  <ul class="space-y-5">
    <% files.each do |file| %>
      <% file_url = rails_blob_path(file, only_path: true) %>
      <li class="border-b border-slate-100 pb-5 last:border-0 last:pb-0">
        <div class="flex flex-wrap items-start justify-between gap-3"><div class="min-w-0"><%= link_to file.filename.to_s, file_url, class: "break-all text-sm font-semibold text-blue-700 hover:underline" %><p class="admin-muted mt-1 text-xs"><%= number_to_human_size(file.byte_size) %> · <%= File.extname(file.filename.to_s).delete_prefix('.').upcase %></p></div>
          <% if local_assigns[:job] %><div class="flex flex-wrap gap-2"><% if can?(:create, PrintableModel) %><%= link_to "Save to model library", new_admin_printable_model_path(source_job_id: job.id, attachment_id: file.id), class: "admin-btn admin-btn-secondary" %><% end %><% if can?(:files, job) %><%= button_to "Delete", file_admin_job_path(job, file_id: file.id), method: :delete, class: "admin-btn admin-btn-danger", data: { turbo_confirm: "Delete #{file.filename}? This cannot be undone." } %><% end %></div><% end %>
        </div>
        <% if File.extname(file.filename.to_s).downcase == ".stl" %>
          <details class="mt-4" data-controller="stl-preview" data-stl-preview-url-value="<%= file_url %>" data-action="toggle->stl-preview#toggle">
            <summary class="w-fit cursor-pointer text-sm font-medium text-blue-700">3D preview</summary>
            <div class="stlviewer relative mt-3 h-80 w-full overflow-hidden rounded-xl border border-slate-200 bg-slate-50" data-file-url="<%= file_url %>" data-stl-preview-target="canvas" aria-label="Interactive 3D preview of <%= file.filename %>"></div>
            <p class="admin-muted mt-2 text-xs" data-stl-preview-target="status" role="status">Open to load the preview. Drag to rotate; scroll to zoom.</p>
          </details>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %><p class="admin-muted text-sm">No model files attached.</p><% end %>
