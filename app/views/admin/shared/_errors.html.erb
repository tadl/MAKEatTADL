<% if record.errors.any? %>
  <div role="alert" class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
    <p class="font-semibold">Please review these fields.</p>
    <ul class="mt-2 list-disc pl-5"><% record.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
  </div>
<% end %>
