<p style="font-size:1.13em; margin-bottom:1.2em;">
  Hi <%= @staff_user.name %>,
</p>

<p style="margin-bottom:1em;">
  You were mentioned in a message on Job <strong>#<%= @job.id %></strong> in MAKE@TADL:
</p>

<blockquote style="border-left: 4px solid #21428d; padding-left: 1rem; color: #333; margin:0 0 2em 0;">
  <%= simple_format(@message.body) %>
</blockquote>

<p style="margin-bottom:2em;">
  <a href="<%= job_url(@job) %>" class="btn">View This Job</a>
</p>
