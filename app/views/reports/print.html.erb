<main class="container my-5">
  <h1 class="mb-4">
    3D Printing Report for <%= @period.strftime("%B %Y") %>
  </h1>

  <table class="table table-bordered">
    <tbody>
      <tr>
        <th>Orders</th>
        <td>
          <%= @orders_count %> total
          (<%= @resin_count %> resin, <%= @fdm_count %> FDM, <%= @multiple_count %> multi-color);
          <%= @cancelled_count %> cancelled
        </td>
      </tr>
      <tr>
        <th>Individuals</th>
        <td><%= @distinct_patrons %> distinct patrons</td>
      </tr>
      <tr>
        <th>Total Prints</th>
        <td><%= @total_quantity %></td>
      </tr>
      <tr>
        <th>Unique Designs</th>
        <td><%= @unique_designs %></td>
      </tr>
      <tr>
        <th>Filament Used</th>
        <td><%= number_with_delimiter(@filament_grams) %> g</td>
      </tr>
      <tr>
        <th>Resin Used</th>
        <td><%= number_with_delimiter(@resin_ml) %> mL</td>
      </tr>
      <tr>
        <th>Most Popular Filament Color</th>
        <td>
          <% if @popular_filament.present? %>
            <%= @popular_filament.titleize %>
          <% else %>
            (none this month)
          <% end %>
        </td>
      </tr>
    </tbody>
  </table>

  <div class="card mb-4">
    <div class="card-header bg-light">
      <h3 class="mb-0">Prints by Category</h3>
    </div>
    <div class="card-body p-0">
      <table class="table mb-0">
        <thead>
          <tr>
            <th>Category</th>
            <th class="text-end"># of Jobs</th>
          </tr>
        </thead>
        <tbody>
          <% @category_counts.each do |name, count| %>
            <tr>
              <td><%= name %></td>
              <td class="text-end"><%= count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card mb-4">
    <div class="row g-0 align-items-stretch">
      <div class="col-lg-8">
        <div class="p-2 d-flex flex-column h-100 justify-content-between">
          <div>
            <canvas id="printsPerDayChart" height="100"></canvas>
          </div>
          <div class="mt-4">
            <canvas id="filamentPerDayChart" height="100"></canvas>
          </div>
        </div>
      </div>
      <div class="col-lg-4 border-start">
        <div class="p-2 h-100 d-flex flex-column justify-content-center align-items-center">
          <canvas id="filamentColorChart" height="200"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4">
    <%= link_to "Previous Month",
          print_report_path(year:  (@period << 1).year, month: (@period << 1).month),
          class: "btn btn-outline-secondary me-2" %>
    <% unless @period >= Date.current.beginning_of_month %>
      <%= link_to "Next Month",
            print_report_path(year:  (@period >> 1).year, month: (@period >> 1).month),
            class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
</main>

<% sorted_dates = @filament_per_day.keys.sort %>
<% sorted_labels = sorted_dates.map { |d| d.strftime("%b %-d") } %>
<% sorted_values = sorted_dates.map { |d| @filament_per_day[d] } %>

<script type="module">
import "chart.js";

const chartColors = [
  "#4e79a7", "#f28e2b", "#e15759", "#76b7b2", "#59a14f",
  "#edc949", "#af7aa1", "#ff9da7", "#9c755f", "#bab0ab"
];

// Prints per Day Line Chart
new window.Chart(document.getElementById('printsPerDayChart').getContext('2d'), {
  type: 'line',
  data: {
    labels: <%= raw @prints_per_day.keys.map { |d| d.strftime("%b %-d") }.to_json %>,
    datasets: [{
      label: 'Prints per Day',
      data: <%= raw @prints_per_day.values.to_json %>,
      borderColor: '#3a8ee6',
      backgroundColor: 'rgba(54, 162, 235, 0.10)',
      borderWidth: 2,
      pointRadius: 2,
      fill: true,
      tension: 0.4
    }]
  },
  options: {
    responsive: true,
    plugins: {
      title: { display: true, text: 'Prints per Day' },
      legend: { display: false }
    },
    scales: { y: { beginAtZero: true, precision: 0 } }
  }
});

// Filament Used Per Day Line Chart
new window.Chart(document.getElementById('filamentPerDayChart').getContext('2d'), {
  type: 'line',
  data: {
    labels: <%= raw sorted_labels.to_json %>,
    datasets: [{
      label: 'Filament Used (g)',
      data: <%= raw sorted_values.to_json %>,
      borderColor: '#3ad29f',
      backgroundColor: 'rgba(58,210,159,0.10)',
      borderWidth: 2,
      pointRadius: 2,
      fill: true,
      tension: 0.4
    }]
  },
  options: {
    responsive: true,
    plugins: {
      title: { display: true, text: 'Filament Used Per Day (g)' },
      legend: { display: false }
    },
    scales: { y: { beginAtZero: true, precision: 0 } }
  }
});

// Filament Color Pie Chart
new window.Chart(document.getElementById('filamentColorChart').getContext('2d'), {
  type: 'pie',
  data: {
    labels: <%= raw @filament_color_counts.keys.map(&:titleize).to_json %>,
    datasets: [{
      data: <%= raw @filament_color_counts.values.to_json %>,
      backgroundColor: chartColors
    }]
  },
  options: {
    responsive: true,
    plugins: {
      legend: { position: 'bottom' },
      title: { display: true, text: 'Filament Color Popularity' }
    }
  }
});
</script>
