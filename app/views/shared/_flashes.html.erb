<% flash.each do |type, message| %>
  <% css_class = case type.to_sym
       when :notice then "flash flash--success"
       when :alert  then "flash flash--danger"
       else "flash flash--#{type}"
     end %>
  <% live_role = type.to_sym == :alert ? "alert" : "status" %>
  <div class="<%= css_class %>"
       role="<%= live_role %>"
       aria-live="<%= type.to_sym == :alert ? "assertive" : "polite" %>">
    <span class="flash__message"><%= message %></span>
    <button type="button"
            class="flash__close"
            aria-label="Dismiss"
            onclick="this.closest('.flash').remove()">
      &times;
    </button>
  </div>
<% end %>
