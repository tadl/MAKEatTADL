<dialog id="app-dialog" class="app-dialog" aria-labelledby="app-dialog-title" aria-describedby="app-dialog-message">
  <h2 id="app-dialog-title">Confirm action</h2>
  <p id="app-dialog-message"></p>
  <div class="app-dialog-actions">
    <button type="button" class="app-dialog-button" data-dialog-cancel autofocus>Cancel</button>
    <button type="button" class="app-dialog-button app-dialog-button-primary" data-dialog-accept>Continue</button>
  </div>
</dialog>
