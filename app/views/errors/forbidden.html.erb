<main class="container my-5 text-center">
  <div class="display-1 text-warning mb-3">403</div>
  <h2 class="mb-3">Access Forbidden</h2>
  <p class="lead mb-4">
    Looks like you’ve tried to check out a page<br>
    reserved for library staff or approved patrons.
  </p>
  <p>
    If you think you should have access, please check your credentials or <a href="mailto:support@tadl.org">contact us</a> for help.
  </p>
  <div class="mb-4">
    <span style="font-size: 4rem;">🔒📚</span>
  </div>
  <%= link_to "Back to Home", root_path, class: "btn btn-warning" %>
</main>
