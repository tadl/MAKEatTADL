<!-- app/views/portal/show.html.erb -->

<main class="job-details container my-0">
  <!-- Back link -->
  <div class="card shadow-sm">
    <!-- Header -->
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
      <h2 class="mb-0">
        <%= @job.is_a?(PrintJob) ? "Print Request" : "Scan Request" %>
        <small class="text-light">#<%= @job.id %></small>
      </h2>
      <div class="d-flex align-items-center">
        <%= bootstrap_status_badge(@job.status) %>
        <% if @job.category.name == 'Staff' %>
          <span class="badge bg-dark text-white ms-2">Staff</span>
        <% end %>
      </div>
    </div>

    <!-- Body -->
    <div class="card-body">
      <div class="row g-4 flex-md-row flex-column">
        <!-- LEFT: Metadata card -->
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="bg-light rounded-3 shadow-sm h-100 px-1 py-1">
            <table class="table table-borderless align-middle mb-0">
              <tbody>
                <!-- Submitted -->
                <tr>
                  <th class="w-50 text-secondary fw-semibold" style="min-width: 160px;">
                    <i class="bi bi-calendar3 me-1"></i> Submitted
                  </th>
                  <td class="fw-bold"><%= @job.created_at.strftime("%b %-d, %Y %l:%M %p") %></td>
                </tr>
                <!-- Pickup Location -->
                <% if (loc = PickupLocation.find_by(code: @job.pickup_location)) %>
                  <tr>
                    <th class="text-secondary fw-semibold">
                      <i class="bi bi-geo-alt me-1"></i> Pickup Location
                    </th>
                    <td class="fw-bold"><%= loc.name %></td>
                  </tr>
                <% elsif @job.pickup_location.present? %>
                  <tr>
                    <th class="text-secondary fw-semibold">
                      <i class="bi bi-geo me-1"></i> Pickup Location
                    </th>
                    <td class="fw-bold"><%= @job.pickup_location.humanize %></td>
                  </tr>
                <% end %>
                <!-- Print Type (PrintJob only) -->
                <% if @job.is_a?(PrintJob) && @job.print_type %>
                  <tr>
                    <th class="text-secondary fw-semibold">
                      <i class="bi bi-award me-1"></i> Print Type
                    </th>
                    <td class="fw-bold"><%= @job.print_type.name %></td>
                  </tr>
                <% end %>
                <!-- Filament Color (PrintJob only) -->
                <% if @job.is_a?(PrintJob) && @job.filament_color.present? %>
                  <tr>
                    <th class="text-secondary fw-semibold">
                      <i class="bi bi-droplet-half me-1"></i> Filament Color
                    </th>
                    <td class="fw-bold"><%= @job.filament_color %></td>
                  </tr>
                <% end %>
                <!-- Est. Print Time (PrintJob only) -->
                <% if @job.is_a?(PrintJob) && @job.print_time_estimate.present? %>
                  <tr>
                    <th class="text-secondary fw-semibold">
                      <i class="bi bi-clock me-1"></i> Est. Print Time
                    </th>
                    <td class="fw-bold"><%= "#{@job.print_time_estimate_hm} hr:min" %></td>
                  </tr>
                <% end %>
                <!-- Slicer Weight (PrintJob only) -->
                <% if @job.is_a?(PrintJob) && @job.slicer_weight.present? %>
                  <tr>
                    <th class="text-secondary fw-semibold">
                      <i class="bi bi-bag me-1"></i> Slicer Weight
                    </th>
                    <td class="fw-bold"><%= "#{@job.slicer_weight} g" %></td>
                  </tr>
                <% end %>
                <!-- Slicer Cost (PrintJob only) -->
                <% if @job.is_a?(PrintJob) && @job.slicer_cost.present? %>
                  <tr>
                    <th class="text-secondary fw-semibold">
                      <i class="bi bi-currency-dollar me-1"></i> Slicer Cost
                    </th>
                    <td class="fw-bold"><%= number_to_currency(@job.slicer_cost) %></td>
                  </tr>
                <% end %>
                <!-- Actual Weight (PrintJob only) -->
                <% if @job.is_a?(PrintJob) && @job.actual_weight.present? %>
                  <tr>
                    <th class="text-secondary fw-semibold">
                      <i class="bi bi-bag me-1"></i> Actual Weight
                    </th>
                    <td class="fw-bold"><%= "#{@job.actual_weight} g" %></td>
                  </tr>
                <% end %>
                <!-- Actual Cost (PrintJob only) -->
                <% if @job.is_a?(PrintJob) && @job.actual_cost.present? %>
                  <tr>
                    <th class="text-secondary fw-semibold">
                      <i class="bi bi-currency-dollar me-1"></i> Actual Cost
                    </th>
                    <td class="fw-bold"><%= number_to_currency(@job.actual_cost) %></td>
                  </tr>
                <% end %>
                <!-- Completed On (PrintJob only) -->
                <% if @job.is_a?(PrintJob) && @job.completion_date.present? %>
                  <tr>
                    <th class="text-secondary fw-semibold">
                      <i class="bi bi-calendar-check me-1"></i> Completed On
                    </th>
                    <td class="fw-bold"><%= @job.completion_date.strftime("%b %-d, %Y") %></td>
                  </tr>
                <% end %>
                <!-- Spray OK? (ScanJob only) -->
                <% if @job.is_a?(ScanJob) %>
                  <tr>
                    <th class="text-secondary fw-semibold">
                      <i class="bi bi-shield-check me-1"></i> Spray OK?
                    </th>
                    <td class="fw-bold"><%= @job.spray_ok? ? 'Yes' : 'No' %></td>
                  </tr>
                <% end %>
                <!-- Assigned Printer -->
                <% if @job.assigned_printer %>
                  <tr>
                    <th class="text-secondary fw-semibold">
                      <i class="bi bi-printer me-1"></i> Assigned Printer
                    </th>
                    <td class="fw-bold"><%= @job.assigned_printer.printer_model %></td>
                  </tr>
                <% end %>
                <!-- Notes -->
                <% if @job.notes.present? %>
                  <tr>
                    <th class="text-secondary fw-semibold">
                      <i class="bi bi-chat-left-text me-1"></i> Notes
                    </th>
                    <td class="fw-bold"><%= @job.notes %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- RIGHT: Model Files/URL Card -->
        <div class="col-md-6">
          <div class="p-3 rounded-3 border bg-light shadow-sm h-100">
            <h5 class="fw-semibold mb-3">
              <i class="bi bi-file-earmark-arrow-down me-1"></i> Model
            </h5>

            <% has_files = @job.model_files.attached? %>
            <% has_url   = @job.url.present? %>

            <% if has_files %>
              <h6 class="mb-2">Files</h6>
              <ul class="list-group list-group-flush mb-3">
                <% @job.model_files.each do |file| %>
                  <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-0 bg-transparent border-0 border-bottom">
                    <div class="d-flex align-items-center flex-grow-1 text-truncate" style="min-width:0;">
                      <i class="bi bi-file-earmark-stl text-primary me-1"></i>
                      <%= link_to file.filename.to_s,
                            rails_blob_path(file, disposition: 'attachment'),
                            class: 'text-decoration-none fw-semibold text-truncate',
                            style: "white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" %>
                    </div>
                    <span class="text-muted small ms-2 flex-shrink-0"><%= number_to_human_size(file.byte_size) %></span>
                  </li>
                <% end %>
              </ul>
            <% end %>

            <% if has_url %>
              <h6 class="mb-2 <%= 'mt-3' if has_files %>">URL</h6>
              <p class="mb-0">
                <%= link_to @job.url, @job.url, target: '_blank', rel: 'noopener', class: 'text-decoration-none' %>
              </p>
            <% end %>

            <% unless has_files || has_url %>
              <p class="text-muted">No model provided.</p>
            <% end %>

            <% allowed_statuses = %w[pending information_requested] %>
            <% if allowed_statuses.include?(@job.status.code) %>
              <!-- Upload form -->
              <details class="mb-2 mt-3">
                <summary class="btn btn-outline-secondary btn-sm rounded-pill px-3" style="cursor: pointer;">
                  <i class="bi bi-upload"></i> Upload Model Files
                </summary>
                <div class="mt-3">
                  <%= form_with model: @job, url: attach_model_files_job_path(@job), local: true, multipart: true, method: :patch do |f| %>
                    <%= f.file_field :model_files, multiple: true, accept: '.stl', class: "form-control form-control-sm mb-2" %>
                    <div class="form-text mb-2">You can upload one or more STL files.</div>
                    <%= f.submit "Attach Files", class: "btn btn-sm btn-primary rounded-pill px-3" %>
                  <% end %>
                </div>
              </details>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Messages -->
  <% if @messages.any? %>
    <div class="card mt-4">
      <div class="card-header">Messages</div>
      <div class="card-body">
        <% @messages.each do |message| %>
          <%= render "portal/message", message: message %>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- New message form -->
  <div class="mt-4">
    <h5>Send us a message</h5>
    <%= form_with url: job_conversation_path(@job), scope: :message, local: true do |f| %>
      <div class="mb-3">
        <%= f.text_area :body, class: 'form-control', rows: 4, placeholder: 'Type your message…' %>
      </div>
      <%= f.submit 'Send', class: 'btn btn-primary' %>
    <% end %>
  </div>
</main>
