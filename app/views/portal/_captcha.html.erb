<!-- app/views/portal/_captcha.html.erb -->
<%= hidden_field_tag 'g-recaptcha-response', '', id: 'g-recaptcha-response' %>
<% site_key = ENV['RECAPTCHA_SITE_KEY'] %>

<!-- Keep using the standard v3 script (works with the recaptcha gem).
     Do NOT swap to enterprise.js unless you also change server-side verification. -->
<script src="https://www.google.com/recaptcha/api.js?render=<%= site_key %>" async defer></script>

<script>
(function() {
  // This script lives inside the form via the partial, so we can find the nearest form safely.
  const thisScript = document.currentScript;

  function onReady(cb) {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", cb, { once: true });
    } else {
      cb();
    }
    // For Turbo (if it’s ever enabled on the page that includes this partial later)
    document.addEventListener("turbo:load", cb, { once: true });
  }

  function whenGrecaptchaReady(cb, deadline) {
    if (Date.now() >= deadline) return;
    if (window.grecaptcha && typeof window.grecaptcha.ready === 'function') {
      cb();
    } else {
      setTimeout(() => whenGrecaptchaReady(cb, deadline), 100);
    }
  }

  onReady(() => {
    const form = thisScript.closest && thisScript.closest("form");
    if (!form || form.dataset.recaptchaBound === "1") return;
    form.dataset.recaptchaBound = "1";

    // Find & disable submit buttons until we’ve bound and reCAPTCHA is available.
    const submits = Array.from(
      form.querySelectorAll('button[type="submit"], input[type="submit"]')
    );
    const disableSubmits = (yes) => submits.forEach(btn => btn.disabled = !!yes);

    disableSubmits(true);

    // As soon as we know our submit handler is attached, we can safely enable.
    // We’ll also try to wait for grecaptcha to be present, but don’t block forever.
    let pendingAttempt = null;
    let submitting = false;
    let enabled = false;
    const enableWhenReady = () => {
      if (enabled) return;
      enabled = true;
      disableSubmits(Boolean(pendingAttempt || submitting));
    };

    // Back navigation can restore this form and its disabled controls from memory.
    window.addEventListener("pageshow", (event) => {
      if (!event.persisted || !form.isConnected) return;
      if (pendingAttempt) clearTimeout(pendingAttempt.timeout);
      pendingAttempt = null;
      submitting = false;
      enabled = true;
      delete form.dataset.recaptchaDone;
      const token = form.querySelector('[name="g-recaptcha-response"]');
      if (token) token.value = "";
      disableSubmits(false);
    });

    // If grecaptcha loads quickly, great—enable now.
    whenGrecaptchaReady(enableWhenReady, Date.now() + 2000);
    // Otherwise, fail-safe: enable after 2s so users aren’t stuck if grecaptcha is blocked.
    setTimeout(enableWhenReady, 2000);

    form.addEventListener("submit", (e) => {
      if (submitting) {
        e.preventDefault();
        return;
      }

      // If we already minted a token for this submission, let it through.
      if (form.dataset.recaptchaDone === "1") {
        submitting = true;
        disableSubmits(true);
        return;
      }

      e.preventDefault();
      if (pendingAttempt) return;

      const attempt = {};
      pendingAttempt = attempt;
      disableSubmits(true);

      const finish = (failed) => {
        if (pendingAttempt !== attempt) return;
        clearTimeout(attempt.timeout);
        pendingAttempt = null;
        disableSubmits(false);
        if (failed && form.isConnected) {
          document.dispatchEvent(new CustomEvent("app:alert", { detail: {
            title: "Unable to verify your request",
            message: "reCAPTCHA couldn’t load. Please try again."
          } }));
        }
      };
      const isCurrent = () => pendingAttempt === attempt;
      const deadline = Date.now() + 10000;
      attempt.timeout = setTimeout(() => finish(true), 10000);

      whenGrecaptchaReady(() => {
        if (!isCurrent() || !form.isConnected) return finish(false);

        try {
          grecaptcha.ready(() => {
            if (!isCurrent() || !form.isConnected) return finish(false);

            let execution;
            try {
              execution = grecaptcha.execute("<%= site_key %>", { action: "submit" });
            } catch (_) {
              finish(true);
              return;
            }
            Promise.resolve(execution)
            .then((token) => {
              // A timed-out attempt must never submit a token that arrives later.
              if (!isCurrent()) return;
              if (!form.isConnected) return finish(false);
              if (typeof token !== "string" || !token) return finish(true);

              let input = form.querySelector("#g-recaptcha-response") ||
                          form.querySelector('[name="g-recaptcha-response"]');
              if (!input) {
                input = document.createElement("input");
                input.type = "hidden";
                input.name = "g-recaptcha-response";
                input.id   = "g-recaptcha-response";
                form.appendChild(input);
              }
              input.value = token;

              form.dataset.recaptchaDone = "1";
              finish(false);

              // Submit for real
              if (form.requestSubmit) form.requestSubmit();
              else {
                submitting = true;
                disableSubmits(true);
                form.submit();
              }

              // The patron may have changed a field while the token was pending.
              // If native validation stopped submission, allow a fresh attempt.
              if (!submitting) {
                delete form.dataset.recaptchaDone;
                input.value = "";
              }
            })
            .catch(() => finish(true));
          });
        } catch (_) {
          finish(true);
        }
      }, deadline);
    }, { passive: false });
  });
})();
</script>
