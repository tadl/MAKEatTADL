<div class="card mb-4">
  <div class="card-header">
    <h4 class="mb-0">Photo of the Object</h4>
  </div>
  <div class="card-body">
    <%= label_tag 'job[scan_image]', 'Upload Photo', class: 'form-label' %>
    <%= file_field_tag 'job[scan_image]',
                        accept: 'image/png,image/jpeg,image/heic,image/heif,.heic,.heif',
                        id: 'job_scan_image',
                        class: 'form-control' %>
    <div class="form-text">
      Upload a clear <strong>PNG, JPEG, or HEIC</strong> photo of your object (include a ruler or common item for scale).
      ZIP/model files are not allowed here.
    </div>
  </div>
</div>
