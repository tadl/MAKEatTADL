<!-- app/views/portal/_model_upload_or_url.html.erb -->
<div class="card mb-4">
  <div class="card-header"><h4 class="mb-0">Model</h4></div>
  <div class="card-body">
    <%= label_tag 'job[model_files][]', 'Upload Model File(s)', class: 'form-label' %>
    <%= file_field_tag 'job[model_files][]',
          accept: '.stl,.3mf,model/stl,application/sla,model/3mf,application/3mf,application/vnd.ms-package.3dmanufacturing-3dmodel',
          multiple: true,
          id: 'job_model_file',
          class: 'form-control' %>

    <div id="job_model_file_feedback"
         class="invalid-feedback d-block small mt-2"
         style="display:none"
         aria-live="polite"></div>

    <div class="form-text">
      Allowed file types: STL (<code>.stl</code>) or 3MF (<code>.3mf</code>).
    </div>

    <br/>

    <%= label_tag 'job[url]', 'Or paste a URL to a Model here', class: 'form-label' %>
    <%= url_field_tag 'job[url]', params.dig(:job, :url),
          id: 'job_url', class: 'form-control' %>
  </div>
</div>

<script>
(function(){
  const input    = document.getElementById('job_model_file');
  const feedback = document.getElementById('job_model_file_feedback');
  if (!input) return;

  // Zip MIME types (3MF files are ZIP containers, so we treat ZIP as OK only if the extension is .3mf)
  const ZIP_TYPES = ['application/zip','application/x-zip-compressed','multipart/x-zip'];

  function isValid(file){
    const name = (file.name || '').toLowerCase();
    const type = (file.type || '').toLowerCase();
    const isSTL = name.endsWith('.stl');
    const is3MF = name.endsWith('.3mf');

    // If it's a 3MF, allow even when the browser reports ZIP-ish content types.
    if (is3MF) return true;

    // STL is allowed; block if the browser claims it's a zip (shouldn't happen, but be safe)
    if (isSTL) return !ZIP_TYPES.includes(type);

    return false;
  }

  function showError(msg){
    if (!feedback) return;
    feedback.style.display = '';
    feedback.textContent = msg;
    input.classList.add('is-invalid');
  }

  function clearError(){
    if (!feedback) return;
    feedback.style.display = 'none';
    feedback.textContent = '';
    input.classList.remove('is-invalid');
  }

  input.addEventListener('change', () => {
    const files = Array.from(input.files || []);
    if (files.length === 0) {
      clearError();
      return;
    }

    const valid   = [];
    const invalid = [];

    files.forEach(f => (isValid(f) ? valid : invalid).push(f));

    if (invalid.length > 0) {
      // Preserve valid files using DataTransfer where supported
      try {
        const dt = new DataTransfer();
        valid.forEach(f => dt.items.add(f));
        input.files = dt.files;
      } catch (_) {
        input.value = '';
      }

      const names = invalid.map(f => f.name).join(', ');
      showError('Only STL (.stl) or 3MF (.3mf) files are allowed. Rejected: ' + names);
    } else {
      clearError();
    }
  });
})();
</script>
