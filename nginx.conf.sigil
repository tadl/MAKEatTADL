# Custom Dokku Nginx template: preserve real client IP

upstream {{ .APP }} {
  # Dokku’s default unix socket for your “web” process
  server unix:/tmp/nginx.socket;
}

server {
  # listen on both IPv4 & IPv6, on the port Dokku has assigned
  listen      [::]:{{ .NGINX_PORT }} default_server;
  listen      {{ .NGINX_PORT }}     default_server;

  # your app’s configured vhosts (or fall back to the global ones)
  server_name {{ .NOSSL_SERVER_NAME }} {{ .DOKKU_GLOBAL_VHOSTS }};

  # longer keep-alive, dyno-style
  keepalive_timeout 600;

  location / {
    proxy_http_version 1.1;

    # preserve the real Host header
    proxy_set_header Host              $host;

    # log the immediate peer (your internal dokku proxy)
    proxy_set_header X-Real-IP         $remote_addr;

    # keep the full client chain so Rails#remote_ip sees the original
    proxy_set_header X-Forwarded-For   $http_x_forwarded_for;

    # standard forwarding headers
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port  $server_port;

    proxy_pass http://{{ .APP }};
  }

  # (optional) add static-file or /up health-check locations here
}
