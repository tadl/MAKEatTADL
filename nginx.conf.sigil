# ────────────────────────────────────────────────────────────────
# Custom Dokku Nginx template: preserve upstream X-Forwarded-For
# ────────────────────────────────────────────────────────────────

upstream dokku_%APP_NAME%_web {
  server unix:/tmp/nginx.socket;
}

server {
  listen [::]:%DOKKU_NGINX_PORT% default_server;
  listen      %DOKKU_NGINX_PORT% default_server;

  # if you have app vhosts, they'll appear here; otherwise
  # fallback to the global vhost(s)
  server_name %NGINX_SERVER_NAMES% %DOKKU_GLOBAL_VHOSTS%;

  keepalive_timeout 600;

  location / {
    proxy_http_version 1.1;
    proxy_set_header Host            $host;
    proxy_set_header X-Forwarded-For $http_x_forwarded_for;
    proxy_set_header X-Real-IP       $remote_addr;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port  $server_port;

    proxy_pass http://dokku_%APP_NAME%_web;
  }

  # You can still define a /up healthcheck or static locations here…
}
