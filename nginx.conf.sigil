# ────────────────────────────────────────────────────────────────
# Custom Dokku Nginx template: preserve upstream X-Forwarded-For
# ────────────────────────────────────────────────────────────────

upstream dokku_{{ var "APP" }}_web {
  # Dokku’s default socket
  server unix:/tmp/nginx.socket;
}

server {
  # listen on both IPv4 & IPv6 using the PROXY_PORT sigil
  listen      {{ var "DOKKU_PROXY_PORT" }} default_server;
  listen [::]:{{ var "DOKKU_PROXY_PORT" }} default_server;

  # your app’s domains (or fall back to global vhosts)
  server_name {{ var "NGINX_SERVER_NAMES" }} {{ var "DOKKU_GLOBAL_VHOSTS" }};

  # long keep-alive for dynos
  keepalive_timeout 600;

  location / {
    proxy_http_version 1.1;

    # preserve the real Host header
    proxy_set_header Host              $host;

    # leave X-Forwarded-For untouched
    proxy_set_header X-Forwarded-For   $http_x_forwarded_for;

    # still log the immediate remote in X-Real-IP
    proxy_set_header X-Real-IP         $remote_addr;

    # standard proxy headers
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port  $server_port;

    proxy_pass http://dokku_{{ var "APP" }}_web;
  }

}
