# ────────────────────────────────────────────────────────────────
# Custom Dokku Nginx template: preserve upstream X-Forwarded-For
# ────────────────────────────────────────────────────────────────

upstream dokku_{{ var "APP" }}_web {
  server unix:/tmp/nginx.socket;
}

server {
  listen      {{ var "DOKKU_PROXY_PORT" }} default_server;
  listen [::]:{{ var "DOKKU_PROXY_PORT" }} default_server;

  # If you have any app‐ or global‐vhosts they'll go here; otherwise we
  # fall back to '_' which is a valid catch-all.
  server_name {{ var "NGINX_SERVER_NAMES" }} {{ var "DOKKU_GLOBAL_VHOSTS" }} _;

  keepalive_timeout 600;

  location / {
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-For   $http_x_forwarded_for;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port  $server_port;
    proxy_pass http://dokku_{{ var "APP" }}_web;
  }

}
